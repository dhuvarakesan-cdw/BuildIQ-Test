{
  "featureId": "FEAT-000",
  "name": "Application Foundation",
  "appShell": {
    "id": "app-shell-foundation",
    "name": "Application shell",
    "entryPoint": "frontend/src/main.tsx",
    "mountedComponent": "frontend/src/App.tsx",
    "runtime": "Vite React TypeScript",
    "accessibility": {
      "skipLinkId": "skip-link-main-content",
      "topbarId": "topbar-primary",
      "mainLandmarkId": "main-content"
