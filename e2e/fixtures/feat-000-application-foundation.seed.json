    {
      "id": "shell-area-hooks",
      "name": "Hooks",
      "path": "frontend/src/hooks/"
    },
    {
      "id": "shell-area-domain",
      "name": "Domain utilities",
      "path": "frontend/src/domain/"
    },
    {
      "id": "shell-area-storage",
      "name": "Storage adapters",
      "path": "frontend/src/storage/"
    }
  ],
  "serviceBoundaries": [
    {
      "id": "boundary-no-backend",
      "name": "No backend service",
      "status": "absent"
